# Copy to .env and fill in LLM_API_KEY. Plain `pnpm run` scripts read this
# file via dotenv -- there is no docker-compose in this example.

# ── LLM (the agent's brain) ──────────────────────────────────────────────────
# Which provider the agent uses to decide when to call the booking tool.
# One of: anthropic (default) | openai | azure | gemini
LLM_PROVIDER=anthropic
# Your real provider key. Required — the agent is a real LLM agent.
#   anthropic → an Anthropic API key
#   openai    → an OpenAI API key
#   azure     → your Azure OpenAI resource key (+ the AZURE_* vars below)
#   gemini    → a Google AI Studio API key
LLM_API_KEY=
# Optional model override. Currently only read by the Gemini provider
# (defaults to gemini-flash-latest); the other providers use a fixed model.
LLM_MODEL=

# Only needed when LLM_PROVIDER=azure (Azure OpenAI). Put values on their own
# lines — do NOT append trailing "# comments" after a value.
# Endpoint, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Your chat model deployment name (used as the model), e.g. gpt-4o
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Hosted HelixID (defaults assume it's already running on localhost) ───────
# HELIX_API_URL is intentionally NOT set here -- config.ts defaults it to
# http://localhost:3000, the hosted API this example expects to already be
# running (see README.md). Only set it if you're pointing at a genuinely
# different host.
# HELIX_API_URL=http://localhost:3000

# Only needed by the guided revoke/delegate demo buttons, which call the
# hosted API's admin-only routes directly. Must match whatever admin key the
# hosted API was actually started with.
HELIX_ADMIN_API_KEY=dev-admin-key-change-in-production
# Passphrase that encrypts each agent's wallet, stored locally under
# .data/wallets/ (see .gitignore) -- nothing here is a Docker volume.
WALLET_PASSPHRASE=demo-passphrase

# NOTE: No Hedera credentials are required. Agents enroll with a local did:key
# wallet via the single-roundtrip /v1/enroll flow, using a token pasted from
# the hosted Console -- the whole trust flow is real, only the topology
# differs from examples/e2e-travel-concierge.
