# Choose one: gemini, openai, anthropic
LLM_PROVIDER=gemini

# Optional. With no key (or if the provider fails), the demo automatically
# falls back to its deterministic scripted planner -- this example is fully
# testable without a working LLM key at all.
LLM_API_KEY=

# Optional. Leave blank to use the demo default for the selected provider.
# Examples: gemini-flash-latest, gpt-4o-mini, claude-sonnet-4-5
LLM_MODEL=

# ── Hosted HelixID (defaults assume it's already running on localhost) ───────
# HELIX_API_URL is intentionally NOT set here -- helixid-config/index.ts
# defaults it to http://localhost:3000, the hosted API this example expects
# to already be running (see README.md).
# HELIX_API_URL=http://localhost:3000

# Only used for best-effort audit posting. Must match whatever admin key the
# hosted API was actually started with.
HELIX_ADMIN_API_KEY=dev-admin-key-change-in-production
# Passphrase that encrypts the agent's and SPs' local key material, stored
# under .data/ (see .gitignore) -- nothing here is a Docker volume.
WALLET_PASSPHRASE=demo-passphrase
